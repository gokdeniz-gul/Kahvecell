# Bu dosyayı ".env" adıyla kopyalayıp değerleri düzenleyin. .env repoya girmez.
APP_NAME=KahveCell API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./kahvecell.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rastgele bir değer üretmek için: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=buraya-uzun-rastgele-bir-deger-yazin
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30

# SMS simülasyonu: gerçek SMS gönderilmez, kod her zaman bu değerdir.
OTP_SIMULATION_CODE=1234
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Abonelik dönemi (gün)
SUBSCRIPTION_PERIOD_DAYS=30
